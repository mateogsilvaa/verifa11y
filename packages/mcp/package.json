    "url": "https://github.com/mateogsilvaa/verifa11y/issues"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "fix",
    "codemod",
    "verifier",
    "html",
    "mcp",
    "model-context-protocol",
    "agents",
    "mcp-server",
    "accessibility-checker",
    "html-accessibility",
