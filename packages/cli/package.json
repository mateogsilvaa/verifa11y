  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "fix",
    "codemod",
    "verifier",
    "html",
    "cli",
    "accessibility-checker",
    "html-accessibility",
    "accessibility-testing",
    "wcag-fixer",
    "playwright",
    "mcp",
    "ai-agents",
    "github-action"
